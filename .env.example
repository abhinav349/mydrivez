# ─────────────────────────────────────────────────────────────
# MyDrivez environment variables
# Copy to .env (local) or add in Vercel → Project → Settings → Environment Variables.
# Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# REQUIRED ────────────────────────────────────────────────────
# PostgreSQL connection string (Neon / Supabase / RDS / local).
# Neon on Vercel: use the pooled URL here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mydrivez?sslmode=require"

# 32+ random characters. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Public base URL (used in emails, invoices, sitemap). On Vercel set to your domain.
APP_URL="https://mydrivez.vercel.app"

# DEMO / FEATURE FLAGS ────────────────────────────────────────
# "true" enables demo helpers ONLY where no real provider is configured:
#   - simulated payment sandbox (when Razorpay keys are absent)
#   - OTP codes / reset links shown on screen (when no email provider)
# Set to "false" for a real launch.
DEMO_MODE="true"

# Protects /api/cron/reminders (Vercel Cron sends it automatically as a Bearer token).
CRON_SECRET=""

# PAYMENTS — Razorpay (https://dashboard.razorpay.com → Settings → API Keys) ──
# Use rzp_test_* keys for sandbox; switch to rzp_live_* at launch.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard → Webhooks → URL: https://YOUR_DOMAIN/api/payments/razorpay/webhook
# Events: payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=""

# Optional future integration (not wired to checkout yet)
STRIPE_SECRET_KEY=""

# EMAIL — Resend (https://resend.com) ─────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="MyDrivez <no-reply@yourdomain.com>"

# MEDIA — Cloudinary for public images (vehicle photos, avatars) ──
# Without these, images are stored in Postgres and served from /api/files/[id].
# Customer identity documents are ALWAYS stored privately, never on a public CDN.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# SMS / WHATSAPP — Twilio (optional) ──────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_WHATSAPP_FROM=""
